# Copy to .env for local overrides. Defaults run on SQLite with no services.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./fcedge.db
# Production example:
# DATABASE_URL=postgresql+psycopg2://fcedge:fcedge@postgres:5432/fcedge
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# OPENAI_API_KEY=sk-...   # optional, enables the LLM AI Coach
